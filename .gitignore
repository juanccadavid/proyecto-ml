# ---------- Secretos ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- DATOS (nunca a Git) ----------
data/*
!data/README.md
!data/raw/
!data/processed/
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv
*.xlsx
*.xls
*.parquet
*.feather
*.sav
*.dta

# ---------- Modelos y experimentos ----------
models/**
!models/.gitkeep
*.joblib
*.pkl
mlflow.db
mlflow.db-journal
optuna.db
mlruns/
mlartifacts/

# ---------- Respaldos git ----------
*.bundle

# ---------- Python / entorno ----------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# ---------- Reportes generados pesados ----------
reports/**/*.html

# ---------- Métricas que regenera make pipeline en cada corrida (local y en el CI) ----------
# Reproducibles (semillas fijas) y ya guardadas en MLflow y en el artefacto "resultados" del CI. Los JSON que ya
# están en Git siguen versionados; para fijar uno nuevo a propósito: git add -f (ver reports/README.md).
reports/metrics/campeon_*.json
reports/metrics/regresion_*.json
reports/metrics/segmentos_*.json
reports/metrics/validacion_cruzada_*.json

# ---------- IDEs / SO ----------
.vscode/*
!.vscode/extensions.json
.idea/
.cursor/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- Claude Code (config personal) ----------
.claude/settings.local.json

# ---------- Datos FICTICIOS de ejemplo (única excepción: sí van a Git) ----------
# Generados con scripts/generar_asociados_ejemplo.py; nunca poner datos reales aquí.
!data/ejemplo/
!data/ejemplo/*.parquet
!data/ejemplo/*.xlsx

# ---------- Formulario web: conexión local a Supabase ----------
web/config.js

# PyCaret escribe su registro en la carpeta actual
logs.log
