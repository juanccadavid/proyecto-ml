# Copia este archivo como .env y completa los valores. El .env NUNCA va a Git.

# ---- Datos ----
DATA_PATH=data/processed/dataset.parquet
TARGET_COLUMN=target
# Columnas que NO son variables del modelo (identificador, fecha de corte, entidad para agrupar)
ID_COLUMN=
TIME_COLUMN=
GROUP_COLUMN=
RANDOM_STATE=42
TEST_SIZE=0.2

# ---- Anonimización (solo quien custodia los datos) ----
# Generar con: make salt   (mínimo 16 caracteres; no compartir ni subir)
ANON_SALT=

# ---- MLflow ----
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=proyecto-1

# ---- Tokens personales (solo si se usan) ----
# Hugging Face: https://huggingface.co/settings/tokens (permiso read)
HF_TOKEN=
# GitHub (para el MCP de .mcp.json): token fine-grained con acceso solo a este repo
GITHUB_PAT=

# ---- Supabase (scripts/contrato_datos.py subir) ----
# Project Settings > API Keys. Usar la clave pública (anon/publishable), nunca la service_role.
SUPABASE_URL=
SUPABASE_KEY=

# ---- Supabase: LEER la tabla (make supabase-bajar) ----
# Clave SECRETA (Project Settings > API Keys > Secret keys). Solo en este .env: nunca en Git, en la web
# ni en un chat. Salta el RLS: da acceso total a la base de datos.
SUPABASE_SECRET_KEY=

# ---- Datos para los modelos de abandono (make abandono). Deja UNA línea sin comentar ----
DATOS_ASOCIADOS=data/ejemplo/asociados_ejemplo.parquet
# DATOS_ASOCIADOS=data/raw/supabase_asociados.parquet
